<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- §8. Звонок без экрана набора -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- §8. Список звонящих аккаунтов при двух SIM -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- §8. Локация и геофенсы -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- §8. Переходы Activity Recognition -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- §8. Уведомление foreground service -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- §8. Имена подключаемых Bluetooth-устройств -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- §8. SSID Wi-Fi -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- §8. Поднять сервис после перезагрузки -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- §8. Экран отключения оптимизации батареи -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        §4.3, §12.3. Интенсивная сессия держит PARTIAL_WAKE_LOCK: foreground service
        сам по себе не мешает системе усыпить процессор, а не-wakeup датчики при
        засыпании перестают доставлять отсчёты, и 15 минут при погашенном экране
        не записались бы полностью. Пассивный слой wake lock не берёт — там ту же
        задачу решает аппаратная пакетная передача.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- §3. Отсутствие любого датчика не является ошибкой -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.gyroscope"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.barometer"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".SesameApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sesame">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Sesame">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- §9. Один foreground service с типом location, живёт постоянно -->
        <service
            android:name=".service.CollectorService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- §4.4. Поднять сервис после перезагрузки устройства -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            §4.4. Геофенсы и переходы Activity Recognition.

            Оба приёмника не экспортированы: Play Services будят их нашим же
            явным PendingIntent, а не неявным броадкастом, поэтому ограничения
            Android 8 на статические приёмники здесь ни при чём.

            Bluetooth, экран, зарядка и Wi-Fi в манифесте отсутствуют намеренно:
            их броадкасты статическому приёмнику не доставляются, и они
            регистрируются в рантайме из сервиса (см. events/SystemEventWatcher).
        -->
        <receiver
            android:name=".events.GeofenceReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.vlad230596.sesame.action.GEOFENCE_EVENT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".events.ActivityTransitionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.vlad230596.sesame.action.ACTIVITY_TRANSITION" />
            </intent-filter>
        </receiver>

        <!--
            §7. Экспорт файлов через share sheet. Данные лежат в Documents/ и
            выдаются наружу только временным грантом на конкретный архив.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- §4.2. Glance-виджет: A / B / Запись -->
        <receiver
            android:name=".widget.SesameWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sesame_widget_info" />
        </receiver>

    </application>

</manifest>
